<!-- 会议详情页 -->
<view class="page-container">
  <scroll-view class="content-scroll" scroll-y enable-flex>

    <!-- 会议标题 -->
    <view class="card">
      <view class="section-title-bar">
        <view class="title-left">
          <text class="field-label">会议主题</text>
        </view>
        <view class="copy-btn" bindtap="copyTitle" wx:if="{{recording.title}}">
          <text>📋</text>
        </view>
      </view>
      <textarea
        class="input-field title-textarea"
        value="{{recording.title}}"
        bindinput="onTitleEdit"
        placeholder="输入会议主题"
        auto-height
        maxlength="500"
      />
    </view>

    <!-- 会议录音播放器 -->
    <view class="card audio-card" wx:if="{{hasAudio}}">
      <view class="audio-row">
        <view class="audio-play {{isPlaying ? 'playing' : ''}}" bindtap="togglePlay">
          <text wx:if="{{!isPlaying}}">▶</text>
          <text wx:else>❚❚</text>
        </view>
        <view class="audio-meta">
          <text class="audio-title">🎧 会议录音</text>
          <view class="audio-progress">
            <view class="audio-bar">
              <view class="audio-fill" style="width: {{audioDuration ? audioCurrent / audioDuration * 100 : 0}}%;"></view>
            </view>
            <text class="audio-time">{{audioCurrent}}″ / {{audioDuration}}″</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-grid">
      <view class="action-btn" bindtap="processTranscribe" wx:if="{{!recording.transcript}}">
        <view class="action-btn-icon icon-blue"><text>📝</text></view>
        <text class="action-btn-text">转文字</text>
      </view>
      <view class="action-btn" bindtap="processSummarize" wx:if="{{!recording.summary}}">
        <view class="action-btn-icon icon-green"><text>📄</text></view>
        <text class="action-btn-text">生成摘要</text>
      </view>
      <view class="action-btn" bindtap="processMindmap">
        <view class="action-btn-icon icon-purple"><text>🧠</text></view>
        <text class="action-btn-text">思维导图</text>
      </view>
      <view class="action-btn" bindtap="processKnowledgeGraph">
        <view class="action-btn-icon icon-orange"><text>🔗</text></view>
        <text class="action-btn-text">知识图谱</text>
      </view>
    </view>

    <!-- 原文稿 -->
    <view class="card" wx:if="{{recording.transcript}}">
      <view class="section-title-bar">
        <view class="title-left">
          <text class="field-label">📜 原文稿</text>
          <text class="edit-hint">（点击编辑）</text>
        </view>
        <view class="copy-btn" bindtap="copyTranscript">
          <text>📋</text>
        </view>
      </view>
      <textarea
        class="textarea-field"
        value="{{recording.transcript}}"
        bindinput="onTranscriptEdit"
        placeholder="文字稿将显示在这里..."
        auto-height
        maxlength="5000"
      />
    </view>

    <!-- AI 摘要 -->
    <view class="card" wx:if="{{recording.summary}}">
      <view class="section-title-bar">
        <view class="title-left">
          <text class="field-label">📋 AI 摘要</text>
          <text class="edit-hint">（点击编辑）</text>
        </view>
        <view class="copy-btn" bindtap="copySummary">
          <text>📋</text>
        </view>
      </view>
      <textarea
        class="textarea-field"
        value="{{recording.summary}}"
        bindinput="onSummaryEdit"
        placeholder="AI摘要将显示在这里..."
        auto-height
        maxlength="5000"
      />
    </view>

    <!-- 关键要点 -->
    <view class="card" wx:if="{{recording.key_points && recording.key_points.length > 0}}">
      <view class="section-title-bar">
        <view class="title-left">
          <text class="field-label">🎯 关键要点</text>
          <text class="edit-hint">（可编辑）</text>
        </view>
        <view class="copy-all-btn" bindtap="copyAllKeyPoints">
          <text>📋 复制全部</text>
        </view>
      </view>
      <view class="key-points-list">
        <view class="key-point-item" wx:for="{{recording.key_points}}" wx:key="index">
          <text class="point-num">{{index + 1}}.</text>
          <textarea
            class="point-textarea"
            value="{{item}}"
            data-index="{{index}}"
            bindinput="onKeyPointEdit"
            auto-height
            maxlength="1000"
          />
        </view>
      </view>
    </view>

  </scroll-view>

  <!-- 底部操作栏 -->
  <view class="action-bar">
    <button class="btn-primary" bindtap="saveChanges">💾 保存修改</button>
    <button class="btn-secondary" bindtap="share">📤 分享</button>
  </view>
</view>
