/* 思维导图页 */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F4F6FB;
}

.page-header {
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 2rpx solid #F0F0F0;
  flex-shrink: 0;
}

.page-subtitle {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 6rpx;
}

.canvas-wrapper {
  flex: 1;
  overflow: hidden;
}

/* 底部自定义操作栏 */
.action-bar {
  flex-shrink: 0;
  background: #fff;
  padding: 16rpx 30rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0,0,0,0.06);
}

.action-bar-inner {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.action-btn.primary {
  background: linear-gradient(135deg, #3D7EFF, #2B5FD9);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(61, 126, 255, 0.32);
}
.action-btn.secondary { background: #EEF1F7; color: #4A5468; }
.action-btn:active { opacity: 0.85; transform: translateY(1rpx); }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #999;
}
.empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; color: #999; }
.empty-subtext { font-size: 24rpx; color: #bbb; margin-top: 8rpx; }
