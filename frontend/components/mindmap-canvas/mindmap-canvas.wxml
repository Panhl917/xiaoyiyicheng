<!-- 思维导图画布组件 -->
<view class="mindmap-container">
  <canvas
    type="2d"
    id="mindmapCanvas"
    class="mindmap-canvas"
    disable-scroll="{{true}}"
    bindtouchstart="onTouchStart"
    bindtouchmove="onTouchMove"
    bindtouchend="onTouchEnd"
  ></canvas>

  <!-- 缩放工具栏 -->
  <view class="zoom-bar">
    <view class="zoom-btn" bindtap="zoomOut">−</view>
    <text class="zoom-text">{{scaleText}}</text>
    <view class="zoom-btn" bindtap="zoomIn">+</view>
  </view>

  <!-- 底部编辑栏 -->
  <view class="toolbar">
    <view class="tool-btn" bindtap="addRootChild">➕ 添加节点</view>
    <view class="tool-btn" bindtap="resetView">🔄 重置视图</view>
  </view>

  <!-- 编辑弹窗 -->
  <view class="edit-overlay" wx:if="{{showEditDialog}}" bindtap="closeEditDialog">
    <view class="edit-dialog" catchtap="stopPropagation">
      <text class="dialog-title">{{editNodeIsNew ? '✏️ 添加子节点' : '✏️ 编辑节点'}}</text>
      <input
        class="input-field"
        value="{{editNodeText}}"
        placeholder="输入节点文字"
        bindinput="onEditInput"
        focus="{{true}}"
      />
      <view class="dialog-actions">
        <view class="dialog-btn cancel" bindtap="closeEditDialog">取消</view>
        <view class="dialog-btn confirm" bindtap="confirmEdit">确定</view>
      </view>
      <view class="dialog-delete" wx:if="{{!editNodeIsNew && editingNodeId !== 'root'}}" bindtap="deleteNode">
        删除此节点
      </view>
    </view>
  </view>
</view>
