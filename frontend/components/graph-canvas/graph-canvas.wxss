/* 知识图谱组件样式 */
.graph-container {
  width: 100%;
  height: 100%;
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #FAFBFC 0%, #EDF0F5 100%);
}

.graph-canvas {
  width: 100%;
  height: 100%;
}

/* 缩放栏 */
.zoom-bar {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255,255,255,0.92);
  padding: 8rpx 16rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
  z-index: 10;
}

.zoom-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #3D7EFF;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.zoom-btn:active { opacity: 0.7; }

.zoom-text {
  font-size: 22rpx;
  color: #555;
  min-width: 60rpx;
  text-align: center;
  font-weight: 600;
}

/* 图例 */
.legend {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  background: rgba(255,255,255,0.92);
  border-radius: 14rpx;
  padding: 12rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  z-index: 10;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 6rpx 0;
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.legend-label {
  font-size: 20rpx;
  color: #555;
}

/* 底部编辑栏 */
.toolbar {
  position: absolute;
  bottom: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 16rpx;
  background: rgba(255,255,255,0.95);
  padding: 12rpx 24rpx;
  border-radius: 50rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
  z-index: 10;
}

.tool-btn {
  font-size: 24rpx;
  color: #444;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  background: #F0F2F5;
  font-weight: 500;
}

.tool-btn:active { background: #3D7EFF; color: #fff; }

/* 编辑弹窗 */
.edit-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.edit-dialog {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  width: 560rpx;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.15);
  animation: slideUp 0.2s ease;
}

@keyframes slideUp {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 28rpx;
  color: #333;
}

.type-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  gap: 12rpx;
}

.type-label { font-size: 26rpx; color: #666; }

.type-value {
  font-size: 26rpx;
  color: #3D7EFF;
  padding: 10rpx 24rpx;
  background: #F0F6FF;
  border-radius: 8rpx;
}

.dialog-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.dialog-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.dialog-btn.confirm { background: #3D7EFF; color: #fff; }
.dialog-btn.cancel { background: #F0F2F5; color: #666; }
.dialog-btn:active { opacity: 0.8; }

.dialog-delete {
  text-align: center;
  margin-top: 24rpx;
  padding: 16rpx;
  color: #E74C3C;
  font-size: 26rpx;
  border-top: 2rpx solid #F0F0F0;
}
