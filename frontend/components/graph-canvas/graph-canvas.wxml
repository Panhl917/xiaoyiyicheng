<!-- 知识图谱画布组件 -->
<view class="graph-container">
  <canvas
    type="2d"
    id="graphCanvas"
    class="graph-canvas"
    disable-scroll="{{true}}"
    bindtouchstart="onTouchStart"
    bindtouchmove="onTouchMove"
    bindtouchend="onTouchEnd"
    bindlongpress="onLongPress"
  ></canvas>

  <!-- 缩放栏 -->
  <view class="zoom-bar">
    <view class="zoom-btn" bindtap="zoomOut">−</view>
    <text class="zoom-text">{{scaleText}}</text>
    <view class="zoom-btn" bindtap="zoomIn">+</view>
  </view>

  <!-- 节点类型图例 -->
  <view class="legend">
    <view class="legend-item" wx:for="{{nodeTypes}}" wx:for-index="i" wx:key="*this">
      <view class="legend-dot" style="background: {{typeColors[i]}}"></view>
      <text class="legend-label">{{item === 'person' ? '人员' : item === 'topic' ? '主题' : item === 'project' ? '项目' : item === 'time' ? '时间' : '决策'}}</text>
    </view>
  </view>

  <!-- 底部编辑栏 -->
  <view class="toolbar">
    <view class="tool-btn" bindtap="addNewNode">➕ 添加</view>
    <view class="tool-btn" bindtap="resetLayout">🔄 重排</view>
  </view>

  <!-- 节点编辑弹窗 -->
  <view class="edit-overlay" wx:if="{{showNodeDialog}}" bindtap="closeDialog">
    <view class="edit-dialog" catchtap="stopPropagation">
      <text class="dialog-title">{{editIsNew ? '✏️ 添加节点' : '✏️ 编辑节点'}}</text>
      <input
        class="input-field"
        value="{{editLabel}}"
        placeholder="节点名称"
        bindinput="onLabelInput"
        focus="{{true}}"
      />
      <view class="type-row" wx:if="{{editIsNew}}">
        <text class="type-label">类型：</text>
        <picker mode="selector" range="{{nodeTypes}}" bindchange="onTypeChange">
          <text class="type-value">{{nodeTypes[editTypeIndex] === 'person' ? '👤 人员' : nodeTypes[editTypeIndex] === 'topic' ? '📌 主题' : nodeTypes[editTypeIndex] === 'project' ? '📊 项目' : nodeTypes[editTypeIndex] === 'time' ? '📅 时间' : '✅ 决策'}}</text>
        </picker>
      </view>
      <view class="dialog-actions">
        <view class="dialog-btn cancel" bindtap="closeDialog">取消</view>
        <view class="dialog-btn confirm" bindtap="confirmNodeEdit">确定</view>
      </view>
      <view class="dialog-delete" wx:if="{{!editIsNew}}" bindtap="deleteSelectedNode">删除此节点</view>
    </view>
  </view>
</view>
